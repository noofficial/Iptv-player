[Unit]
Description=CableVision 2004 CORS/mixed-content proxy
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /var/www/iptv/deploy/iptv-proxy.py
Restart=on-failure
RestartSec=3
User=www-data
Group=www-data
Environment=PUBLIC_PROXY_URL=https://iptv.silverbasin.vegas/proxy
# Flip to 1 to log every client request header to journalctl. Off by
# default — handy for debugging what a real IPTV client is sending.
Environment=PROXY_DEBUG_HEADERS=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
